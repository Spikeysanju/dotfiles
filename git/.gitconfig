# Public template — real name/email live in identity-work (gitignored).
# Agents: ask the user for work name/email and write git/identity-work.
# install.sh symlinks identity-work → ~/.gitconfig-identity-work

[include]
	path = ~/.gitconfig-identity-work

[user]
	signingkey = ~/.ssh/github-work.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[includeIf "gitdir:~/me/"]
	path = ~/.gitconfig-personal

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
