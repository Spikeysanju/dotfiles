# Public template — real name/email live in gitignored identity files.
# install.sh symlinks:
#   git/identity-personal → ~/.gitconfig-identity-personal  (default, everywhere)
#   git/identity-work     → ~/.gitconfig-identity-work      (only ~/agi and ~/AGI)

[include]
	path = ~/.gitconfig-identity-personal

[includeIf "gitdir:~/agi/"]
	path = ~/.gitconfig-identity-work

[includeIf "gitdir:~/AGI/"]
	path = ~/.gitconfig-identity-work

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
